<Window x:Class="Fangcun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="方寸 - 原型" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="枚举桌面图标" Width="120" HorizontalAlignment="Left" Click="Enumerate_Click"/>
        <ListBox Grid.Row="1" x:Name="IconList" Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="#"/><Run Text="{Binding Index}"/>
                        <Run Text="   "/>
                        <Run Text="{Binding Text}"/>
                        <Run Text="   ("/><Run Text="{Binding X}"/><Run Text=","/><Run Text="{Binding Y}"/><Run Text=")"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
