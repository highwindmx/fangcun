<Window x:Class="Fangcun.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fangcun"
        x:Name="Root"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" MinWidth="104"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Border x:Name="RootBorder" CornerRadius="12"
            Background="{Binding Style.BgColor, Converter={StaticResource BrushConv}}" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="6"
            AllowDrop="True"
            DragEnter="ItemsHost_DragEnter" DragOver="ItemsHost_DragOver"
            DragLeave="ItemsHost_DragLeave" Drop="ItemsHost_Drop">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="{Binding Style.TitleBarColor, Converter={StaticResource BrushConv}}" Cursor="SizeAll" MinHeight="26">
                <TextBlock x:Name="TitleText" Text="{Binding Title}"
                           Foreground="{Binding Style.TitleColor, Converter={StaticResource BrushConv}}"
                           FontFamily="{Binding Style.TitleFontFamily}"
                           FontSize="{Binding Style.TitleFontSize}"
                           FontWeight="Bold"
                           HorizontalAlignment="{Binding Style.TitleAlign, Converter={StaticResource AlignConv}}"
                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="TitleEdit" Visibility="Collapsed" LostFocus="TitleEdit_LostFocus"
                         KeyDown="TitleEdit_KeyDown" Background="#40000000"
                         Foreground="{Binding Style.TitleColor, Converter={StaticResource BrushConv}}"
                         FontFamily="{Binding Style.TitleFontFamily}" FontSize="{Binding Style.TitleFontSize}"
                         BorderThickness="0" Margin="4,2"/>
                <StackPanel x:Name="BtnStrip" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- “…” 菜单入口：左键打开围栏菜单（重命名/配置/溢出模式/删除/新建） -->
                    <Button x:Name="BtnMenu" Content="⋯" Width="24" Height="24" Margin="0,0,2,0"
                            Background="Transparent" Cursor="Hand"
                            Foreground="{Binding Style.TitleColor, Converter={StaticResource BrushConv}}"
                            BorderThickness="0" ToolTip="围栏菜单" Click="BtnMenu_Click"/>
                    <Button x:Name="BtnCollapse" Content="▾" Width="24" Height="24"
                            Background="Transparent" Cursor="Hand"
                            Foreground="{Binding Style.TitleColor, Converter={StaticResource BrushConv}}"
                            BorderThickness="0" ToolTip="折叠/展开" Click="BtnCollapse_Click"/>
                </StackPanel>
                <Grid.ContextMenu>
                    <ContextMenu Opened="TitleCtx_Opened">
                        <MenuItem Header="重命名" Click="MenuRename_Click"/>
                        <!-- 预设主题：自适应/浅色/深色 立即应用；自定义→进入配置窗手动调色 -->
                        <MenuItem Header="预设主题">
                            <MenuItem x:Name="PresetAdaptive" Header="自适应" Tag="Adaptive" IsCheckable="True" Click="MenuPreset_Click"/>
                            <MenuItem x:Name="PresetLight" Header="浅色" Tag="Light" IsCheckable="True" Click="MenuPreset_Click"/>
                            <MenuItem x:Name="PresetDark" Header="深色" Tag="Dark" IsCheckable="True" Click="MenuPreset_Click"/>
                            <Separator/>
                            <MenuItem x:Name="PresetCustom" Header="自定义" IsCheckable="True" Click="MenuConfig_Click"/>
                        </MenuItem>
                        <!-- 显示模式（图标/列表）：左键点“…”、右键标题栏都能开菜单调整 -->
                        <MenuItem Header="显示模式">
                            <MenuItem x:Name="LayoutIcon" Header="图标" Tag="Icon" IsCheckable="True" Click="MenuLayout_Click"/>
                            <MenuItem x:Name="LayoutList" Header="列表" Tag="List" IsCheckable="True" Click="MenuLayout_Click"/>
                        </MenuItem>
                        <MenuItem Header="溢出模式">
                            <MenuItem x:Name="OverflowScroll" Header="滚动" Tag="Scroll" IsCheckable="True" Click="MenuOverflow_Click"/>
                            <MenuItem x:Name="OverflowEllipsis" Header="省略" Tag="Ellipsis" IsCheckable="True" Click="MenuOverflow_Click"/>
                        </MenuItem>
                        <MenuItem Header="层叠模式">
                            <MenuItem x:Name="LayerBottom" Header="置底" Tag="Bottom" IsCheckable="True" Click="MenuLayer_Click"/>
                            <MenuItem x:Name="LayerTop" Header="置顶" Tag="Top" IsCheckable="True" Click="MenuLayer_Click"/>
                            <MenuItem x:Name="LayerWindow" Header="窗口" Tag="Window" IsCheckable="True" Click="MenuLayer_Click"/>
                        </MenuItem>
                        <MenuItem Header="同步模式">
                            <MenuItem x:Name="SyncManual" Header="手动" Tag="Manual" IsCheckable="True" Click="MenuSync_Click"/>
                            <MenuItem x:Name="SyncWatch" Header="监视" Tag="Watch" IsCheckable="True" Click="MenuSync_Click"/>
                        </MenuItem>
                        <MenuItem Header="删除围栏" Click="MenuDelete_Click"/>
                        <Separator/>
                        <MenuItem Header="新建围栏" Click="MenuNewFence_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>

            <!-- 条目区 -->
            <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent" AllowDrop="True"
                          PreviewMouseLeftButtonDown="ItemsHost_PreviewMouseLeftButtonDown"
                          MouseLeftButtonDown="Scroller_MouseLeftButtonDown"
                          Drop="ItemsHost_Drop" DragEnter="ItemsHost_DragEnter"
                          DragOver="ItemsHost_DragOver" DragLeave="ItemsHost_DragLeave">
                <ItemsControl x:Name="ItemsHost" AllowDrop="True" Background="Transparent">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemLayout}" Value="List">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="4"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                        <Border x:Name="ItemBorder" Padding="4" AllowDrop="True"
                                PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Item_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
                                Drop="Item_Drop" DragEnter="Item_DragEnter"
                                DragOver="Item_DragOver" DragLeave="Item_DragLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="76"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#665A8ADE"/>
                                        </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemLayout}" Value="List">
                                                <Setter Property="Width" Value="Auto"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="打开" Click="ItemOpen_Click"/>
                                        <MenuItem Header="打开所在位置" Click="ItemOpenLocation_Click"/>
                                        <Separator/>
                                        <MenuItem Header="从围栏移除" Click="ItemRemove_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <!-- 图标布局 -->
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource IconVis}">
                                                <Binding Path="IsEllipsis"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=local:FenceWindow}" Path="DataContext.Style.ItemLayout"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <Image Source="{Binding IconSource}" Width="40" Height="40" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemColor, Converter={StaticResource BrushConv}}"
                                                   FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemFontFamily}"
                                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemFontSize}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxHeight="28" Margin="0,2,0,0"
                                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ShowItemName, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <!-- 列表布局 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource ListVis}">
                                                <Binding Path="IsEllipsis"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=local:FenceWindow}" Path="DataContext.Style.ItemLayout"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <Image Source="{Binding IconSource}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,6,0"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemColor, Converter={StaticResource BrushConv}}"
                                                   FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemFontFamily}"
                                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ItemFontSize}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:FenceWindow}, Path=DataContext.Style.ShowItemName, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 右下角截断计数角标（折线样式）：显示被裁掉的图标数；点击向下展开全部 -->
            <Grid Grid.Row="1" x:Name="TruncBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,3,3" Width="26" Height="26" Cursor="Hand"
                  MouseLeftButtonDown="TruncBadge_Click" Visibility="Collapsed"
                  ToolTip="被截断的图标数；点击向下展开全部">
                <Path Data="M3,23 L23,23 L23,3" Stretch="None"
                      Stroke="{Binding Style.TitleColor, Converter={StaticResource BrushConv}}"
                      StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Opacity="0.9"/>
                <TextBlock x:Name="TruncBadgeText" Text="0"
                           Foreground="{Binding Style.TitleColor, Converter={StaticResource BrushConv}}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3"/>
            </Grid>
        </Grid>
    </Border>
</Window>
