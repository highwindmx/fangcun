<Window x:Class="Fangcun.FenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fangcun"
        Title="围栏配置" Width="380" Height="500" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Manual"
        Background="#F5F5F7" WindowStyle="ToolWindow" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="13" Foreground="#333"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#D0D0D5"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" x:Name="Scroller">
            <StackPanel>
                <GroupBox Header="背景样式" x:Name="GroupCustom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="背景颜色"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <Rectangle Width="24" Height="18" Stroke="#999" StrokeThickness="1" Fill="{Binding Cfg.BgColor, Converter={StaticResource BrushConv}}"/>
                            <TextBox x:Name="TxtBg" Width="74" Margin="6,0,0,0" Text="{Binding Cfg.BgColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" LostFocus="CustomColor_LostFocus"/>
                            <Button Content="选择" Width="52" Margin="6,0,0,0" Click="PickBgColor_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="栏底色"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Rectangle Width="24" Height="18" Stroke="#999" StrokeThickness="1" Fill="{Binding Cfg.TitleBarColor, Converter={StaticResource BrushConv}}"/>
                            <TextBox x:Name="TxtBar" Width="74" Margin="6,0,0,0" Text="{Binding Cfg.TitleBarColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" LostFocus="CustomColor_LostFocus"/>
                            <Button Content="选择" Width="52" Margin="6,0,0,0" Click="PickTitleBarColor_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="标题栏样式">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="字体"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TitleFont" SelectedItem="{Binding Cfg.TitleFontFamily, Mode=TwoWay}" ItemsSource="{Binding Fonts}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="大小"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="40" Value="{Binding Cfg.TitleFontSize, Mode=TwoWay}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="颜色"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Rectangle Width="24" Height="18" Stroke="#999" StrokeThickness="1" Fill="{Binding Cfg.TitleColor, Converter={StaticResource BrushConv}}"/>
                            <TextBox x:Name="TxtTitleColor" Width="74" Margin="6,0,0,0" Text="{Binding Cfg.TitleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" LostFocus="CustomColor_LostFocus"/>
                            <Button Content="选择" Width="52" Margin="6,0,0,0" Click="PickTitleColor_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="对齐"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding Cfg.TitleAlign, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Header="条目样式">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="字体"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ItemFont" SelectedItem="{Binding Cfg.ItemFontFamily, Mode=TwoWay}" ItemsSource="{Binding Fonts}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="大小"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="32" Value="{Binding Cfg.ItemFontSize, Mode=TwoWay}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="颜色"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Rectangle Width="24" Height="18" Stroke="#999" StrokeThickness="1" Fill="{Binding Cfg.ItemColor, Converter={StaticResource BrushConv}}"/>
                            <TextBox x:Name="TxtItemColor" Width="74" Margin="6,0,0,0" Text="{Binding Cfg.ItemColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" LostFocus="CustomColor_LostFocus"/>
                            <Button Content="选择" Width="52" Margin="6,0,0,0" Click="PickItemColor_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="显示名称"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Cfg.ShowItemName, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="完成" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Done_Click"/>
    </Grid>
</Window>
